! Collisionless drift benchmark in W7X geometry.  With collisions off and the
! run linear, the bounce-averaged radial magnetic drift is the ONLY source in
! the budget, so this isolates the drift channel and tests it at 100 per cent
! of the drive rather than as a small correction to the collisional one.
!
! The initial condition carries a parallel flow rather than a zonal potential.
! That matters for the momentum invariant: started from a potential its
! projection is near zero, and the conservation statement is then a ratio of
! two small numbers rather than a test.
&parameters_physics
  adiabatic_option = 'field-line-average-term'
  nonlinear = .false.
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.05
  nakx = 1
/
&init_g_knobs
  ginit_option = 'default'
  phiinit = 1.0
  den0 = 0.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 600
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 8
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_w7x_standard.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
