! Linear, collisional, kinetic ions AND electrons, ELECTROSTATIC.
!
! This case exists because the electromagnetic multi-species case next to it
! fails and a single case could not say which of its two new ingredients was
! responsible.  Turning the fields off while keeping the second species answers
! it: the projection is conserved to 3e-3 here and not at all at beta = 4e-3,
! so it is the finite beta and not the second species.
!
! It is also the cheapest case that can see a per-species normalisation error at
! all.  With one species at m = T = 1 a wrong power of sqrt(T/m) and the right
! one are the same number; with kinetic electrons they differ by 61.  That is
! what the momentum inertia bug turned out to be.
!
! Miller is linear, collisionless and axisymmetric here, so every flux channel
! is identically zero and the budget reduces to the statement that the RH
! projection does not move at all.
&parameters_physics
  nonlinear = .false.
  vnew_ref = 0.1
  include_apar = .false.
  include_bpar = .false.
  beta = 0.0
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
&init_g_knobs
  ginit_option = 'default'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 2.2
  mass = 2.7e-4
  temp = 1.0
  tprim = 8.0
  type = 'electron'
  z = -1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 96
/
&vpamu_grids_parameters
  nmu = 12
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 200
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'miller'
/
&millergeo_parameters
  nzed_local = 128
  rhoc = 0.5
  shat = 0.796
  qinp = 1.4
  rmaj = 2.77778
  rgeo = 2.77778
  shift = 0.0
  kappa = 1.0
  kapprim = 0.0
  tri = 0.0
  triprim = 0.0
  betaprim = 0.0
  d2qdr2 = 0.0
  d2psidr2 = 0.0
  betadbprim = 0.0
/
&dissipation
  include_collisions = .true.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
