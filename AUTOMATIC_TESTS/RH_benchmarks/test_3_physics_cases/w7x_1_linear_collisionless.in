! Case 1: linear, collisionless, adiabatic electrons.
! W7-X, one field period along alpha0 = 0.7, zonal mode at kx rho = 0.2.
!
! A single zonal mode initialised with a density perturbation and a parallel
! flow (see init_g_knobs).  The run is linear, so the nonlinear RH fluxes
! vanish; collisions are off, so the collisional channel is absent too.  What
! remains is the magnetic-drift channel P_drift, which is what distinguishes
! this from the tokamak benchmark: in an axisymmetric field the bounce-averaged
! radial drift vanishes and P_drift with it, while here it is the ONLY source.
! This is the one case in the suite that measures the drift channel on its own,
! so its residual is the drift channel's accuracy undiluted.
!
! Tube length.  nfield_periods = 1, and that choice is what the residual hangs
! on.  At fixed nzed = 128 the phi_RH residual at t = 100 reads
!
!    nfield_periods      1       2       4       8
!    max |dB| per step   0.005   0.010   0.033   0.049
!    phi_RH residual     0.025   0.058   0.086   0.150
!
! monotonic in how rugged the field line is per grid point and in nothing
! else that was tried: not the mismatch of B across the periodic join (nfp = 2
! has the same 9% jump as nfp = 8), not the turnover (1.9 here against 1.0 at
! nfp = 8, a factor that would account for 2x of the 6x).  At nfp = 2 the
! residual converges with resolution, slowly and jointly: nzed 64/128/256/512
! give 0.083/0.058/0.042/0.038 and nvgrid 48 -> 96 gives 0.058 -> 0.045, while
! it does not move with delt (0.0580 at delt = 0.05, 0.0579 at 0.025), with the
! mirror scheme (0.060 with finite differences in place of semi-Lagrange), or
! with implicit against explicit drifts.  So it is a discretisation error of
! the parallel dynamics, not of the diagnostic.  Isolating the terms by
! restarting at t = 30 with one operator at a time confirms where it sits: the
! drift projection matches the continuum expression to five digits, and the
! whole of the budget error is the discrete streaming + mirror projection
! missing the exact cancellation -- by 10% of |dPhi/dt| at nfp = 8, which the
! energy budget sees amplified because only about a third of dPhi/dt changes
! the energy.  The weight W is discontinuous at the trapped-passing boundary
! and h develops structure there as it phase-mixes, which is where a fixed
! grid pays; one field period keeps B smooth enough per point for the
! cancellation to hold to 2.5e-02, three times inside the tolerance.
!
! Run length.  nstep = 2000 (t = 100) gives a turnover of 0.68 and a drive of
! 0.66 over the measured window, both clear of the 0.5 floor, and 1.9 over the
! whole run; two invocations of this deck return identical statistics.  The
! residual is converged in time rather than a transient: 2.5e-02 at t = 100,
! 2.3e-02 at t = 300.
!
! alpha0 = 0.7, not 0.  alpha0 = 0 is the stellarator-symmetric line, on which
! B is even in z and the radial drift odd, so the transit-averaged drift of
! every passing particle vanishes: the passing particles contribute nothing to
! the drift flux and the trapped particles, in wells off the symmetry point,
! carry the whole drive.  The residual is worse there, 0.25 at nfp = 2 and
! 0.39 at nfp = 8, for the same discretisation reason with the smoother half
! of the drive removed; at alpha0 = 0.7 both populations drive.
!
! Omega_RH is not asserted for this case.  The secular drift is carried mostly
! by trapped particles and the odd weight has little purchase on them, so the
! momentum projection is weakly driven -- drive 0.31 at t = 100, turnover
! 0.88 -- and its residual (2.9 at t = 100, 1.0 at t = 300) is a ratio of small
! numbers rather than a measurement.
&parameters_physics
  adiabatic_option = 'field-line-average-term'
  nonlinear = .false.
  vnew_ref = 0.1
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
! The linear cases are initialised with BOTH a density perturbation and a
! parallel flow.  Starting from a zonal potential alone leaves the momentum
! projection near zero, and normalising by it inflates the residual into a
! defect that is not there; starting from a flow alone does the same to the
! potential projection.  Exciting both is what makes one run test both.
&init_g_knobs
  ginit_option = 'default'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 2000
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 1
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_w7x_standard.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
