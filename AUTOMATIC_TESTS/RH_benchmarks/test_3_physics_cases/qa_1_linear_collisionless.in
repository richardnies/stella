! Case 1: linear, collisionless, adiabatic electrons.
! QA, zonal mode at kx rho = 0.2.
!
! NOT ASSERTED.  The suite runs Miller and W7-X only; this deck is the W7-X deck
! with the equilibrium swapped -- nothing else differs; see
! w7x_1_linear_collisionless.in for the reasoning behind every parameter.
! make_case_figures.py measures and plots this run with the suite's statistic
! when its output is present, and the report (DOCUMENTATION/stella_RH_report,
! section "The four remaining configurations") collects the numbers of all
! forty-four such runs.
!
! Equilibrium.  QA, the quasi-axisymmetric configuration of the older benchmark
! set (nfp = 2, q = 2.39, shat = 0.02 at rho = 0.71; the largest n /= 0
! harmonic of B is 3.6e-3 of B00).
!
! Tube.  One field period along alpha0 = 0.7 (the W7-X case-1 tube).  Open:
! B 0.986 -> 1.044 across the join, |grad x|^2 ratio 0.34.
!
! Last measured (median relative residual over the last 40% of the run, energy
! turnover of that window in parentheses):
! phi_RH 2.3e-02 (turnover 0.39, below the floor);
! Omega_RH 1.0e+00 (turnover 1.19).
!
! phi_RH 2.3e-02 at a turnover of 0.39, just under the floor, the same
! number the other one-period tubes give (W7-X 2.5e-02, QH 2.2e-02).
! Omega_RH fails at 1.0 (turnover 1.19): the odd invariant is not conserved
! across the join of an open tube, here as in W7-X (2.9).
&parameters_physics
  adiabatic_option = 'field-line-average-term'
  nonlinear = .false.
  vnew_ref = 0.1
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
! The linear cases are initialised with BOTH a density perturbation and a
! parallel flow.  Starting from a zonal potential alone leaves the momentum
! projection near zero, and normalising by it inflates the residual into a
! defect that is not there; starting from a flow alone does the same to the
! potential projection.  Exciting both is what makes one run test both.
&init_g_knobs
  ginit_option = 'default'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 2000
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 1
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_QA.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
