! The multi-species linear cases are ELECTROMAGNETIC.  A second kinetic species
! and a finite beta are the two ingredients that between them broke the momentum
! budget, and testing them together linearly -- where every channel is either
! zero or exactly one thing -- is far sharper than waiting for the nonlinear
! cases to expose them.  This is also the only place in the set where gbar, the
! parallel Ampere solve and the vpar-dApar part of the advecting velocity are
! exercised without turbulence on top.
! MULTIPLE KINETIC SPECIES, linear.  This case exists because it is the one that
! found a real bug.  With every channel identically zero and nothing driving the
! projection, a second kinetic species still degraded conservation tenfold, and
! neither a sixteenfold smaller time step nor a fourfold finer grid moved it --
! which is what identified the momentum inertia's missing parallel-velocity
! normalisation.  A single-species linear case cannot see that error, because for
! m = T = 1 the wrong coefficient and the right one are the same number.
! Case 2: linear, collisional.
! Miller tokamak, zonal mode at kx rho = 0.2.
! Rosenbluth-Hinton energy budget: linear zonal flow with collisional damping.
!
! A single zonal mode (ky = 0, kx = 0.05) initialised with ginit_option='rh'
! and relaxed by Dougherty collisions.  The run is linear, so the nonlinear RH
! fluxes are identically zero and the only source in the budget is
! RH_fluxes_collisional.  This is the cleanest test of the RH diagnostic.
&parameters_physics
  nonlinear = .false.
  vnew_ref = 0.1
  include_apar = .true.
  include_bpar = .true.
  beta = 4.0e-3
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
! The linear cases are initialised with BOTH a density perturbation and a
! parallel flow.  Starting from a zonal potential alone leaves the momentum
! projection near zero, and normalising by it inflates the residual into a
! defect that is not there; starting from a flow alone does the same to the
! potential projection.  Exciting both is what makes one run test both.
&init_g_knobs
  ginit_option = 'default'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 2.2
  mass = 2.7e-4
  temp = 1.0
  tprim = 8.0
  type = 'electron'
  z = -1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 96
/
&vpamu_grids_parameters
  nmu = 12
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 200
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'miller'
/
&millergeo_parameters
  nzed_local = 128
  rhoc = 0.5
  shat = 0.796
  qinp = 1.4
  rmaj = 2.77778
  rgeo = 2.77778
  shift = 0.0
  kappa = 1.0
  kapprim = 0.0
  tri = 0.0
  triprim = 0.0
  betaprim = 0.0
  d2qdr2 = 0.0
  d2psidr2 = 0.0
  betadbprim = 0.0
/
&dissipation
  include_collisions = .true.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
