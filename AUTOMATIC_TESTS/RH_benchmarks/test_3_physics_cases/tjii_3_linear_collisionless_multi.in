! Case 3: linear, collisionless, kinetic ions and electrons, electromagnetic.
! TJ-II, zonal mode at kx rho = 0.2.
!
! NOT ASSERTED.  The suite runs Miller and W7-X only; this deck is the W7-X deck
! with the equilibrium swapped -- nothing else differs; see
! w7x_3_linear_collisionless_multi.in for the reasoning behind every parameter.
! make_case_figures.py measures and plots this run with the suite's statistic
! when its output is present, and the report (DOCUMENTATION/stella_RH_report,
! section "The four remaining configurations") collects the numbers of all
! forty-four such runs.
!
! Equilibrium.  TJ-II (nfp = 4, q = -0.63, shat = -0.06 at rho = 0.71), the
! equilibrium with the most structure in B along the line of the six.
!
! Tube.  Eight field periods along alpha0 = 0.7.  Open: B 1.250 -> 1.337
! across the join, |grad x|^2 ratio 0.18.
!
! Last measured (median relative residual over the last 40% of the run, energy
! turnover of that window in parentheses):
! phi_RH 1.0e+00 (turnover 8.80);
! Omega_RH 2.6e+01 (turnover 4.91).
!
! phi_RH 1.0, Omega_RH 26: the dA_par transient, see w7x_3.
&parameters_physics
  nonlinear = .false.
  vnew_ref = 0.1
  include_apar = .true.
  include_bpar = .true.
  beta = 4.0e-3
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
! The linear cases are initialised with BOTH a density perturbation and a
! parallel flow.  Starting from a zonal potential alone leaves the momentum
! projection near zero, and normalising by it inflates the residual into a
! defect that is not there; starting from a flow alone does the same to the
! potential projection.  Exciting both is what makes one run test both.
&init_g_knobs
  ginit_option = 'default'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 2.2
  mass = 2.7e-4
  temp = 1.0
  tprim = 8.0
  type = 'electron'
  z = -1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 6000
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 8
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_tjii.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
