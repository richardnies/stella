! Case 2: linear, collisionless, kinetic ions and electrons, electrostatic.
! TJ-II, zonal mode at kx rho = 0.2.
!
! NOT ASSERTED.  The suite runs Miller and W7-X only; this deck is the W7-X deck
! with the equilibrium swapped -- nothing else differs; see
! w7x_2_linear_collisionless_kinetic.in for the reasoning behind every
! parameter.  make_case_figures.py measures and plots this run with the suite's
! statistic when its output is present, and the report
! (DOCUMENTATION/stella_RH_report, section "The four remaining configurations")
! collects the numbers of all forty-four such runs.
!
! Equilibrium.  TJ-II (nfp = 4, q = -0.63, shat = -0.06 at rho = 0.71), the
! equilibrium with the most structure in B along the line of the six.
!
! Tube.  One field period along alpha0 = 0, the stellarator-symmetric line
! (the W7-X case-2 tube).  Closed: B = 1.134 at both ends.
!
! Last measured (median relative residual over the last 40% of the run, energy
! turnover of that window in parentheses):
! phi_RH 5.3e-01 (turnover 0.69);
! Omega_RH 4.1e+04 (turnover 0.07, below the floor).
!
! TJ-II is not quasi-symmetric, so alpha0 = 0 is driven here (turnover
! 0.69, like W7-X's 0.70) and the case is a real test.  It reads 0.53,
! and that is parallel resolution: 0.26 at nzed = 256, while nvgrid = 96
! or nmu = 48 leave it at 0.52.  The deck keeps the common nzed = 128
! rather than tuning one configuration; it is not asserted.  On the old
! eight-period tube (|grad x|^2 ratio 0.18) this case blew up (turnover
! 5e2 in the window), the collisionless kinetic-electron growth of w7x_2.
&parameters_physics
  nonlinear = .false.
  vnew_ref = 0.1
  include_apar = .false.
  include_bpar = .false.
  beta = 0.0
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
&init_g_knobs
  ginit_option = 'rh'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 2.2
  mass = 2.7e-4
  temp = 1.0
  tprim = 8.0
  type = 'electron'
  z = -1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 2000
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 1
  torflux = 0.5
  alpha0 = 0.0
  vmec_filename = 'wout_tjii.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
