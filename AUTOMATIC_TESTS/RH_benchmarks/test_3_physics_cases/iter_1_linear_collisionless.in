! Case 1: linear, collisionless, adiabatic electrons.
! ITER, zonal mode at kx rho = 0.2.
!
! NOT ASSERTED.  The suite runs Miller and W7-X only; this deck is the W7-X deck
! with the equilibrium swapped and nfield_periods set to one poloidal turn --
! nothing else differs; see w7x_1_linear_collisionless.in for the reasoning
! behind every parameter.  make_case_figures.py measures and plots this run with
! the suite's statistic when its output is present, and the report
! (DOCUMENTATION/stella_RH_report, section "The four remaining configurations")
! collects the numbers of all forty-four such runs.
!
! Equilibrium.  ITER, an axisymmetric free-boundary equilibrium read through
! VMEC (wout_iter.nc carries twelve n = 0 harmonics and nothing else; it
! is up-down asymmetric).  q = -2.51, shat = 0.21 at rho = 0.71.
!
! Tube.  One poloidal turn: nfield_periods = 2.505 = |q|, which is what a
! closed tube is in an axisymmetric field (one field period would be 0.4
! of a turn and would test nothing).  The two ends coincide to 2e-4 in
! |grad x|^2, so this tube closes, like Miller's.
!
! Last measured (median relative residual over the last 40% of the run, energy
! turnover of that window in parentheses):
! phi_RH 2.1e+00 (turnover 0.06, below the floor);
! Omega_RH 1.6e+04 (turnover 0.02, below the floor).
!
! Both invariants hold on the closed turn and the suite window reads
! nothing (turnovers 0.06, 0.02).  The run is not Miller, though: the
! up-down asymmetric grid leaves a small discrete drift channel, active to
! t ~ 10 (turnover 0.13), on which phi_RH closes at 4.5e-02; after it dies
! away E_RH leaks 10% over the remaining 80 time units with the drift
! channel a third of that.  A closed axisymmetric tube conserves the
! invariant only to the parallel discretisation error.
&parameters_physics
  adiabatic_option = 'field-line-average-term'
  nonlinear = .false.
  vnew_ref = 0.1
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
! The linear cases are initialised with BOTH a density perturbation and a
! parallel flow.  Starting from a zonal potential alone leaves the momentum
! projection near zero, and normalising by it inflates the residual into a
! defect that is not there; starting from a flow alone does the same to the
! potential projection.  Exciting both is what makes one run test both.
&init_g_knobs
  ginit_option = 'default'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 2000
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 2.505
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_iter.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
