! Case 11: nonlinear, electromagnetic (delta A_par and delta B_par).
! QA, zonal mode at kx rho = 0.2.
!
! NOT ASSERTED.  The suite runs Miller and W7-X only; this deck is the W7-X deck
! with the equilibrium swapped -- nothing else differs; see
! w7x_11_nl_em_apar_bpar.in for the reasoning behind every parameter.
! make_case_figures.py measures and plots this run with the suite's statistic
! when its output is present, and the report (DOCUMENTATION/stella_RH_report,
! section "The four remaining configurations") collects the numbers of all
! forty-four such runs.
!
! Equilibrium.  QA, the quasi-axisymmetric configuration of the older benchmark
! set (nfp = 2, q = 2.39, shat = 0.02 at rho = 0.71; the largest n /= 0
! harmonic of B is 3.6e-3 of B00).
!
! Tube.  Eight field periods along alpha0 = 0.7.  Open: B 1.076 -> 0.989
! across the join, |grad x|^2 ratio 0.08 -- the farthest from unity of
! the whole set.
!
! Last measured (median relative residual over the last 40% of the run, energy
! turnover of that window in parentheses):
! phi_RH 9.2e-03 (turnover 16.48);
! Omega_RH 5.7e-02 (turnover 5.22).
!
! Cut by the CFL condition at t = 14.6.  Both invariants close
! (9.2e-03, 5.7e-02).
&parameters_physics
  nonlinear = .true.
  vnew_ref = 0.01
  include_apar = .true.
  include_bpar = .true.
  beta = 1.0e-2
/
&kt_grids_knobs
  grid_option = 'box'
/
&kt_grids_box_parameters
  ny = 12
  nx = 12
  y0 = 5.0
/
&init_g_knobs
  ginit_option = 'noise'
  phiinit = 0.01
  width0 = 1.0
/
&species_knobs
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 2.2
  mass = 1.0
  temp = 1.0
  tprim = 8.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 2.2
  mass = 2.7e-4
  temp = 1.0
  tprim = 8.0
  type = 'electron'
  z = -1.0
/
&zgrid_parameters
  boundary_option = 'stellarator'
  nperiod = 1
  nzed = 64
/
&vpamu_grids_parameters
  nmu = 8
  nvgrid = 18
/
&knobs
  ! Fix the seed: ginit_option='noise' otherwise draws a different initial
  ! condition each run, and these runs grow exponentially, so the residual
  ! would not be reproducible between invocations of the same deck.
  rng_seed = 1
  delt = 0.02
  nstep = 2500
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 2
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 8
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_QA.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
