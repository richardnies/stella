! Case 9: nonlinear, kinetic ions and electrons.
! TJ-II, zonal mode at kx rho = 0.2.
!
! NOT ASSERTED.  The suite runs Miller and W7-X only; this deck is the W7-X deck
! with the equilibrium swapped -- nothing else differs; see w7x_9_nl_kinetic.in
! for the reasoning behind every parameter.  make_case_figures.py measures and
! plots this run with the suite's statistic when its output is present, and the
! report (DOCUMENTATION/stella_RH_report, section "The four remaining
! configurations") collects the numbers of all forty-four such runs.
!
! Equilibrium.  TJ-II (nfp = 4, q = -0.63, shat = -0.06 at rho = 0.71), the
! equilibrium with the most structure in B along the line of the six.
!
! Tube.  Eight field periods along alpha0 = 0.7.  Open: B 1.250 -> 1.337
! across the join, |grad x|^2 ratio 0.18.
!
! Last measured (median relative residual over the last 40% of the run, energy
! turnover of that window in parentheses):
! phi_RH 1.1e+00 (turnover 24.96);
! Omega_RH 6.1e+01 (turnover 192.03).
!
! BLOWS UP: |phi|^2 2e4 at t = 50 and still growing; the numbers are
! measured on the blow-up.  See tjii_8.
&parameters_physics
  nonlinear = .true.
  vnew_ref = 0.01
/
&kt_grids_knobs
  grid_option = 'box'
/
&kt_grids_box_parameters
  ny = 12
  nx = 12
  y0 = 5.0
/
&init_g_knobs
  ginit_option = 'noise'
  phiinit = 0.01
  width0 = 1.0
/
&species_knobs
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 2.2
  mass = 1.0
  temp = 1.0
  tprim = 8.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 2.2
  mass = 2.7e-4
  temp = 1.0
  tprim = 8.0
  type = 'electron'
  z = -1.0
/
&zgrid_parameters
  boundary_option = 'stellarator'
  nperiod = 1
  nzed = 64
/
&vpamu_grids_parameters
  nmu = 8
  nvgrid = 18
/
&knobs
  ! Fix the seed: ginit_option='noise' otherwise draws a different initial
  ! condition each run, and these runs grow exponentially, so the residual
  ! would not be reproducible between invocations of the same deck.
  rng_seed = 1
  delt = 0.02
  nstep = 2500
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 2
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 8
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_tjii.nc'
/
&dissipation
  include_collisions = .true.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
