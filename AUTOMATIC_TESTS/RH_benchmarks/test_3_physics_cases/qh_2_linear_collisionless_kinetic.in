! Case 2: linear, collisionless, kinetic ions and electrons, electrostatic.
! QH, zonal mode at kx rho = 0.2.
!
! NOT ASSERTED.  The suite runs Miller and W7-X only; this deck is the W7-X deck
! with the equilibrium swapped -- nothing else differs; see
! w7x_2_linear_collisionless_kinetic.in for the reasoning behind every
! parameter.  make_case_figures.py measures and plots this run with the suite's
! statistic when its output is present, and the report
! (DOCUMENTATION/stella_RH_report, section "The four remaining configurations")
! collects the numbers of all forty-four such runs.
!
! Equilibrium.  QH, the quasi-helically symmetric configuration of the older
! benchmark set (nfp = 4, q = -0.80, shat = -0.003 at rho = 0.71).
!
! Tube.  One field period along alpha0 = 0, the stellarator-symmetric line
! (the W7-X case-2 tube).  Closed: B = 1.368 at both ends.
!
! Last measured (median relative residual over the last 40% of the run, energy
! turnover of that window in parentheses):
! phi_RH no source, E(T)/E(0) = 0.944;
! Omega_RH no source, E(T)/E(0) = 0.913.
!
! No source: on the quasi-symmetric line the drift channel cancels to
! 1e-16 against a dE/dt of 1e-5, so the row carries E_RH(T)/E_RH(0) =
! 0.944 (phi) and 0.913 (Omega) over t = 100 -- the electron projection
! moving on a neutral state, see w7x_2.  On the old eight-period tube
! (|grad x|^2 ratio 0.81, the closest to unity of the four) this case read
! 0.44, the mildest of the four old-deck failures.
&parameters_physics
  nonlinear = .false.
  vnew_ref = 0.1
  include_apar = .false.
  include_bpar = .false.
  beta = 0.0
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.2
  nakx = 1
/
&init_g_knobs
  ginit_option = 'rh'
  phiinit = 1.0
  den0 = 1.0
  upar0 = 1.0
  width0 = 1.0
/
&species_knobs
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 2.2
  mass = 2.7e-4
  temp = 1.0
  tprim = 8.0
  type = 'electron'
  z = -1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 2000
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_integrands = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 1
  torflux = 0.5
  alpha0 = 0.0
  vmec_filename = 'wout_QH.nc'
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
