! Rosenbluth-Hinton energy budget: minimal nonlinear electrostatic run with
! kinetic ions and UNMODIFIED adiabatic electrons (no flux-surface-average
! term), i.e. a plain Boltzmann response.  Exercises the opposite adiabatic
! closure from rh_nl_adiabatic_electrons.in.
&parameters_physics
  adiabatic_option = 'no-field-line-average-term'
  nonlinear = .true.
  vnew_ref = 0.01
/
&kt_grids_knobs
  grid_option = 'box'
/
&kt_grids_box_parameters
  ! jtwist = 5 puts the zonal mode at kx rho_i = 0.5 rather than 2.5.  The
  ! Rosenbluth-Hinton construction is a long-wavelength one -- it targets
  ! kx rho_i << 1/q, about 0.71 here -- so a box whose only zonal mode sits at
  ! 2.5 tests it outside its range of validity.
  ny = 4
  nx = 4
  y0 = 2.0
  jtwist = 5
/
&init_g_knobs
  ginit_option = 'noise'
  phiinit = 0.01
  width0 = 1.0
/
&species_knobs
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 2.2
  mass = 1.0
  temp = 1.0
  tprim = 8.0
  type = 'ion'
  z = 1.0
/
&zgrid_parameters
  boundary_option = 'linked'
  nperiod = 1
  nzed = 24
/
&vpamu_grids_parameters
  nmu = 8
  nvgrid = 18
/
&knobs
  ! Fix the seed: ginit_option='noise' otherwise draws a different initial
  ! condition each run, and these runs grow exponentially, so the residual would not
  ! be reproducible between invocations of the same deck.
  rng_seed = 1
  delt = 0.02
  nstep = 1400
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 2
  save_for_restart = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'miller'
/
&millergeo_parameters
  nzed_local = 128
  rhoc = 0.5
  shat = 0.796
  qinp = 1.4
  rmaj = 2.77778
  rgeo = 2.77778
  shift = 0.0
  kappa = 1.0
  kapprim = 0.0
  tri = 0.0
  triprim = 0.0
  betaprim = 0.0
  d2qdr2 = 0.0
  d2psidr2 = 0.0
  betadbprim = 0.0
/
&dissipation
  include_collisions = .true.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
