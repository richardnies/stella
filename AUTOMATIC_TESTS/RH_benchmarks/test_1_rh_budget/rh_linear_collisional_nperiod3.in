! Rosenbluth-Hinton diagnostics over three poloidal turns.
!
! Identical to rh_linear_collisional.in except for nperiod = 3, so the flux tube
! spans z in [-5pi, 5pi] rather than [-pi, pi].  The physics is unchanged -- an
! axisymmetric equilibrium simply repeats -- so every RH quantity must come out
! the same, and test_whether_rh_diagnostics_are_independent_of_parallel_length
! asserts that against the nperiod = 1 run.
!
! This is what makes the transit averages trustworthy on a longer domain: the
! z-integration weight dl_over_b is normalised to unit sum, so it cancels in the
! transit-average ratio, and in an axisymmetric field both B and the drift phase
! Q repeat with period 2pi.
!
! A single zonal mode (ky = 0, kx = 0.05) initialised with ginit_option='rh'
! and relaxed by Dougherty collisions.  The run is linear, so the nonlinear RH
! fluxes are identically zero and the only source in the budget is
! RH_fluxes_collisional.  This is the cleanest test of the RH diagnostic.
&parameters_physics
  adiabatic_option = 'field-line-average-term'
  nonlinear = .false.
  vnew_ref = 0.1
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.05
  nakx = 1
/
&init_g_knobs
  ginit_option = 'rh'
  phiinit = 15.0
  width0 = 1.0
/
&species_knobs
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 3
  nzed = 96
/
&vpamu_grids_parameters
  nmu = 12
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 200
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&stella_diagnostics_knobs
  nsave = -1
  nwrite = 1
  save_for_restart = .false.
  write_RH_inertia_fluxes = .true.
/
&geo_knobs
  geo_option = 'miller'
/
&millergeo_parameters
  nzed_local = 128
  rhoc = 0.5
  shat = 0.796
  qinp = 1.4
  rmaj = 2.77778
  rgeo = 2.77778
  shift = 0.0
  kappa = 1.0
  kapprim = 0.0
  tri = 0.0
  triprim = 0.0
  betaprim = 0.0
  d2qdr2 = 0.0
  d2psidr2 = 0.0
  betadbprim = 0.0
/
&dissipation
  include_collisions = .true.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
