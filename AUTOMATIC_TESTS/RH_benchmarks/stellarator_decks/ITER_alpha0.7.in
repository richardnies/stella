! Linear zonal-flow evolution: Rosenbluth-Hinton initial condition, single kx.
&parameters_physics
  nonlinear = .false.
  adiabatic_option = 'field-line-average-term'
  vnew_ref = 0.0
/
&species_knobs
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 0.0
  mass = 1.0
  temp = 1.0
  tprim = 0.0
  type = 'ion'
  z = 1.0
/
&geo_knobs
  geo_option = 'vmec'
/
&vmec_parameters
  nfield_periods = 8
  torflux = 0.5
  alpha0 = 0.7
  vmec_filename = 'wout_iter.nc'
/
&kt_grids_knobs
  grid_option = 'range'
/
&kt_grids_range_parameters
  naky = 1
  aky_min = 0.0
  akx_min = 0.05
  nakx = 1
/
&zgrid_parameters
  boundary_option = 'unconnected'
  nperiod = 1
  nzed = 128
/
&vpamu_grids_parameters
  nmu = 24
  nvgrid = 48
/
&knobs
  delt = 0.05
  nstep = 600
  print_extra_info_to_terminal = .false.
  drifts_implicit = .true.
/
&init_g_knobs
  ginit_option = 'rh'
  phiinit = 1.0
  width0 = 1.0
/
&stella_diagnostics_knobs
  nwrite = 1
  nsave = -1
  save_for_restart = .false.
  write_RH_bounce_drift = .true.
  write_RH_inertia_fluxes = .true.
/
&dissipation
  include_collisions = .false.
  collision_model = 'dougherty'
  hyper_dissipation = .false.
/
